# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor/manual backups
*.orig
*.bak

# eval generated outputs
/eval/output/

# Cartella scratch locale per immagini/manuali (non versionata)
/temp/

# artefatti di rilascio (eseguibile standalone, installer, PDF) — vanno nelle Release
/dist/

# workspace interni / cronologia di sviluppo (non da pubblicare)
/.superpowers/
/claude_code_chat_export/

# tool locali portable (es. gh CLI) — ambiente self-contained, non versionato
/.tools/
